<?xml  version="1.0" encoding="UTF-8" ?>
<taglib version="2.0" xmlns="http://java.sun.com/xml/ns/j2ee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee
        http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd">
	<!-- 标签库版本 -->
	<tlib-version>1.0</tlib-version>
	<!-- 标签库名称 -->
	<short-name>TreeTag</short-name>
	<!-- 标签库URI -->
	<uri>/tree</uri>
	<!-- helloTag begin-->
	<tag>
		<!-- 标签名称 -->
		<name>showTree</name>
		<!-- 标签对应的处理类 -->
		<tag-class>nis.nms.util.tag.leftMenuTag.TreeTag</tag-class>
		<!-- 标签体内容，没有标签体则设为空 -->
		<body-content>empty</body-content>
		<!-- 标签的属性声明 -->
		<!-- 菜单前显示的图片 -->
		<attribute>
			<name>imgSrc</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 菜单前显示的图片的宽度 -->
		<attribute>
			<name>openAndCloseImgWidth</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 是否显示父菜单前的折叠图标 -->
		<attribute>
			<name>showParentOpenAndCloseImg</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 根据xmlStr解析成树 -->
		<attribute>
			<name>xmlStr</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 顶级父菜单的样式 -->
		<attribute>
			<name>parentMenuCss</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 菜单内容的样式 -->
		<attribute>
			<name>menuCss</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 顶级菜单的tr样式 -->
		<attribute>
			<name>topTrCss</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 子菜单名的样式 -->
		<attribute>
			<name>childMenuCss</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 子菜单表的样式 -->
		<attribute>
			<name>childMenuTableCss</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!--  -->
		<attribute>
			<name>onclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 父菜单的背景图片 -->
		<attribute>
			<name>parentMenuBg</name>
			<required>false</required>
		</attribute>
		<!-- 子菜单的背景图片 -->
		<attribute>
			<name>childMenuBg</name>
			<required>false</required>
		</attribute>
		<!-- 左树菜单的详细内容显示的目标frame -->
		<attribute>
			<name>target</name>
			<required>false</required>
		</attribute>
		<!-- 链接前的图片 -->
		<attribute>
			<name>linkMenuImg</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 占位图片 -->
		<attribute>
			<name>spaceImage</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- 鼠标经过事件 -->
		<attribute>
			<name>onMouseOver</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>onMouseOut</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>clickLinkEvent</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>clickParentEvent</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>hrefCss</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<!-- helloTag end-->

</taglib>