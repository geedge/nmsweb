<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="nis.nms.domains.TopoInfo"
		table="TOPO_INFO">
		<id name="id" type="java.lang.Long">
			<column name="id" precision="11" scale="0" />
			<generator class="nis.nms.persistence.SequenceGenerator" >
				<param name="sequence">SEQ_NODEGROUP_POSITION</param>
			</generator>
		</id>
		<property name="name" type="java.lang.String">
			<column name="NAME" length="64" />
		</property>
		<property name="systemId" type="java.lang.Long">
			<column name="SYSTEM_ID" precision="11" scale="0" />
		</property>
		<property name="width" type="java.lang.Long">
			<column name="WIDTH" precision="11" scale="0" />
		</property>
		<property name="height" type="java.lang.Long">
			<column name="HEIGHT" precision="11" scale="0" />
		</property>
		<property name="topoInfoClass" type="java.lang.String">
			<column name="CLASS" length="64" />
		</property>
		<property name="createTime" type="java.util.Date">
			<column name="CREATE_TIME" length="7" />
		</property>
		<property name="createUser" type="java.lang.Long">
			<column name="CREATE_USER" precision="11" scale="0" />
		</property>
		<property name="updateTime" type="java.util.Date">
			<column name="UPDATE_TIME" length="7" />
		</property>
		<property name="updateUser" type="java.lang.Long">
			<column name="UPDATE_USER" precision="11" scale="0" />
		</property>
		<property name="remarks" type="java.lang.String">
			<column name="REMARKS" length="64" />
		</property>
		<property name="threshold" type="java.lang.Long">
			<column name="THRESHOLD" precision="11" scale="0" />
		</property>
		<property name="flag" type="java.lang.Long">
			<column name="FLAG" precision="11" scale="0" />
		</property>
		
	</class>
</hibernate-mapping>
