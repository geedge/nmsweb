<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="nis.nms.domains.TableGuide" table="TABLE_GUIDE">
        <id name="id" type="java.lang.Long">
            <column name="ID" precision="22" scale="0" />
            <generator class="nis.nms.persistence.SequenceGenerator" >
            	<param name="sequence">seq_table_guide</param>
            </generator>
        </id>
        <property name="userId" type="java.lang.Long">
            <column name="USER_ID" precision="22" scale="0" />
        </property>
        <property name="guideId" type="java.lang.Long">
            <column name="GUIDE_ID" precision="22" scale="0" />
        </property>
        <property name="guideName" type="java.lang.String">
            <column name="GUIDE_NAME" length="20" />
        </property>
        <property name="systemId" type="java.lang.Long">
            <column name="SYSTEM_ID" precision="22" scale="0" />
        </property>
    </class>
</hibernate-mapping>
